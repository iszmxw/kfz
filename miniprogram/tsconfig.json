{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "types": ["miniprogram-api-typings", "node", "vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },
    "outDir": "dist",
    "rootDir": ".",
    "skipLibCheck": true
  },
  "include": [
    "app.ts",
    "config/**/*.ts",
    "services/**/*.ts",
    "types/**/*.ts",
    "utils/**/*.ts",
    "pages/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["node_modules", "miniprogram_npm", "dist"]
}
